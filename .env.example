# Optional frontend API origin. Leave unset for the self-contained Browser demo.
# Copy this file to .env.local and restart dev or rebuild after changing it.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend settings: export these in the FastAPI process environment.
# The Python service does not automatically load this file.
# CORS_ORIGINS=http://localhost:3000,https://your-storefront.example
# MATE_WHATSAPP_NUMBER=919322172834
# PORT=8000

# The provided WhatsApp/mobile numbers are unverified.
# Configuration does not verify a contact number. Never add secrets to NEXT_PUBLIC_*.
